# Переменные для docker compose (корневой .env). Ключ модели — не здесь, а в backend/.env.
PRISM_PORT=8000
# за прокси (nginx/Caddy) на сервере — 127.0.0.1
PRISM_BIND=0.0.0.0
# 1 — cookie сессии только по HTTPS (на сервере за прокси)
COOKIE_SECURE=0
SEARXNG_SECRET=замените-на-длинную-случайную-строку
# домен для Caddy: docker compose --profile https up -d
DOMAIN=localhost
