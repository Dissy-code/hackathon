# Скопируйте в backend/.env и заполните. Файл .env в git не попадает.

# Провайдер модели — один, любой OpenAI-совместимый API.
# Open WebUI: base_url оканчивается на /api, ключ — Settings → Account → API Keys.
LLM_BASE_URL=https://chat.astra-dev.online/api
LLM_API_KEY=
LLM_MODEL=ornith-1.5-35b-a3b
# Модель для картинок (аудит слайдов, разбор шаблонов). Пусто — та же, что LLM_MODEL.
LLM_VISION_MODEL=
# Стиль параметров провайдера: vllm | openrouter | plain (см. configs/default.yaml)
LLM_API_STYLE=vllm

# MCP-серверы (docker compose поднимает их сам). Локально:
#   python -m prism.mcp.web_server --port 8001   (нужен SearXNG: SEARXNG_URL)
#   python -m prism.mcp.pptx_server --port 8002
MCP_WEB_URL=
MCP_PPTX_URL=
