# Скопируйте в backend/.env и заполните. Файл .env в git не попадает.

# Профиль моделей из configs/default.yaml: dev (Open WebUI) | final (инференс VK)
PRISM_PROFILE=dev

# Open WebUI: Settings → Account → API Keys. base_url заканчивается на /api
OWUI_BASE_URL=https://chat.astra-dev.online/api
OWUI_API_KEY=

# Инференс VK (финал), OpenAI-совместимый
VK_LLM_BASE_URL=
VK_LLM_API_KEY=
