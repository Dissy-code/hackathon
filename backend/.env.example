# Скопируйте в backend/.env и заполните. Файл .env в git не попадает.

# Провайдер модели — один, любой OpenAI-совместимый API.
#   vLLM / llama.cpp:  http://host:8000/v1          (LLM_API_STYLE=vllm)
#   Open WebUI:        https://host/api             (LLM_API_STYLE=vllm; ключ — Settings → Account → API Keys)
#   OpenRouter-совместимые шлюзы: https://…/api/v1  (LLM_API_STYLE=openrouter)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Модель для картинок (аудит слайдов, разбор шаблонов). Пусто — та же, что LLM_MODEL.
LLM_VISION_MODEL=
# Стиль параметров провайдера: vllm | openrouter | plain (см. configs/default.yaml)
LLM_API_STYLE=vllm

# Демо-режим без модели: 1 — подставной текст, настоящие вёрстка, рендер и аудит.
LLM_FAKE=

# MCP-серверы (docker compose поднимает их сам и задаёт адреса). Локально:
#   python -m prism.mcp.web_server --port 8001   (нужен SearXNG: SEARXNG_URL)
#   python -m prism.mcp.pptx_server --port 8002
MCP_WEB_URL=
MCP_PPTX_URL=
